    // Configure on cron-job.org:
    //   https://iarepo.com/cron/run.php?job=link_check&token=YOUR_SECRET  (every 6h)
    //   https://iarepo.com/cron/run.php?job=moderation&token=YOUR_SECRET  (every 2min)
    'CRON_SECRET' => 'GENERATE_A_64_CHAR_HEX_STRING_HERE',

    // Open registration — enables moderation, rate limits, similarity checks
    // Set to true when public sign-up is enabled
    'OPEN_REGISTRATION' => false,

    // Debug mode — shows stack traces in API error responses
