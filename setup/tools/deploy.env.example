# ================================================================
# setup/tools/deploy.env.example
#
# Plantilla de configuración para los scripts de setup/tools/ que hablan
# con el servidor (hoy: generate-thumbnails.sh).
#
#   cp setup/tools/deploy.env.example setup/tools/deploy.env
#   $EDITOR setup/tools/deploy.env
#
# deploy.env está en .gitignore y NO debe subirse nunca: este repo es
# público (se espeja en GitHub), así que ni IP, ni usuario SSH, ni puerto,
# ni la ruta del doc root pueden acabar en un fichero versionado.
#
# El entorno tiene prioridad sobre este fichero, así que también vale:
#   IAREPO_SSH_HOST=... IAREPO_SSH_PORT=... ./setup/tools/generate-thumbnails.sh
# ================================================================

# usuario@host del servidor
IAREPO_SSH_HOST="usuario@servidor.example"

# Puerto SSH
IAREPO_SSH_PORT="22"

# Ruta ABSOLUTA de la carpeta thumbnails/ dentro del doc root del servidor
IAREPO_THUMBS_DIR="/ruta/al/docroot/thumbnails"

# Opcional: base de las páginas que se capturan (por defecto la de producción)
# IAREPO_BASE_URL="https://iarepo.com/view"
