RewriteEngine On

# ── Branded error page ───────────────────────────
ErrorDocument 404 /404.php

# ── CORS Preflight ───────────────────────────────
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=200,L]

# ── Pretty URLs ──────────────────────────────────
# /sitemap.xml → sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /view/123 → viewer/index.php?id=123
RewriteRule ^view/(\d+)$ viewer/index.php?id=$1 [L,QSA]

# /resource/123 → resource/index.php?id=123
RewriteRule ^resource/(\d+)$ resource/index.php?id=$1 [L,QSA]

# /profile/123 → profile/index.php?id=123
RewriteRule ^profile/(\d+)$ profile/index.php?id=$1 [L,QSA]

# ── Security: block sensitive files & directories ──
<FilesMatch "^\.env\.php$">
    Require all denied
</FilesMatch>

# Block all setup scripts (seeds, schema, migrations, cron)
<Directory "setup">
    Require all denied
</Directory>
# Fallback for hosts that ignore <Directory> in .htaccess
RewriteRule ^setup/ - [F,L]

# Admin tools self-protect with ADMIN_PASS — allow only those two entry
# points; block any other file under admin/ (includes, partials, etc.)
RewriteRule ^admin/(errors|create)\.php$ - [L]
RewriteRule ^admin/ - [F,L]

# Block shared PHP files from direct web access
RewriteRule ^shared/ - [F,L]

# Block raw SQL files everywhere
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# ── Branded 404 for unknown paths ────────────────
# LiteSpeed/Hostinger ignores ErrorDocument here, so route any path that
# isn't a real file/dir to 404.php (which sets the 404 status itself).
# /api/ is excluded so missing endpoints don't return an HTML page.
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /404.php [L]

# ── CORS Headers ─────────────────────────────────
<IfModule mod_headers.c>
    # Allow Campus domains (any subdomain) + iarepo.com
    SetEnvIf Origin "^https://([a-z0-9-]+\.)?claseprivada\.com$" CORS_ORIGIN=$0
    SetEnvIf Origin "^https://(iarepo\.com|www\.iarepo\.com)$" CORS_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "86400"

    # ── Security headers ─────────────────────────────
    # (No X-Frame-Options: the /view/ viewer is meant to be embedded cross-site.)
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── MIME types (PWA) ─────────────────────────────
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# ── PHP settings ─────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
