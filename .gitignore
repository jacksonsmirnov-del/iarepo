# Environment & secrets
.env.php

# Coordenadas del servidor para los scripts de setup/tools/ (host SSH, puerto,
# doc root). El repo es público: solo se versiona la plantilla .example.
setup/tools/deploy.env

# Sello de versión que escribe setup/hooks/post-receive en el doc root del
# servidor en cada deploy (commit, fecha, rama, asunto). Lo genera el servidor:
# no se versiona. Si se commiteara, el `checkout -f main` del deploy lo
# machacaría con un valor equivocado y api/health.php mentiría sobre qué commit
# está vivo.
deploy_version.txt

